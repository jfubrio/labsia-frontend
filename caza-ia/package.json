{
  "name": "caza-ia",
  "version": "0.1.0",
  "private": true,
  "description": "CAZA IA — vigilancia de precios, validación de descuentos reales y compras autorizadas (fase 1: sin compras)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx src/scripts/phase1-demo.ts",
    "profile": "tsx src/scripts/profile.ts",
    "db:check": "bash scripts/pg-check.sh",
    "verify": "npm run typecheck && npm test && npm run demo",
    "migrate:print": "cat src/db/migrations/*.sql",
    "test:db": "bash scripts/with-temp-pg.sh npx vitest run tests/db",
    "watch:once": "tsx src/scripts/watch-once.ts",
    "watch:worker": "tsx src/scripts/watch-worker.ts",
    "phase2:check": "bash scripts/phase2-check.sh",
    "phase2:worker-check": "bash scripts/phase2-worker-check.sh",
    "api": "tsx src/scripts/api-server.ts",
    "phase5:check": "bash scripts/phase5-check.sh",
    "phase7:check": "bash scripts/phase7-check.sh"
  },
  "dependencies": {
    "bullmq": "^6.3.12",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
