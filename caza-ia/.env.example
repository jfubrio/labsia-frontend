# CAZA IA — fase 1
NODE_ENV=development
CAZA_PHASE=1
# Las compras solo pueden habilitarse a partir de CAZA_PHASE=6. Con fase < 6 y 'true' el arranque falla.
PURCHASES_ENABLED=false
DEFAULT_AUTHORIZATION_TTL_HOURS=24
# Tipo de cambio fijo para la comparación internacional hasta la fase 4 (tipo de cambio en vivo).
USD_MXN_RATE=18.5

# Fase 2: vigilancia programada
# DATABASE_URL=postgres://caza:caza@localhost:5432/caza_dev
# REDIS_URL=redis://localhost:6379/0

# Fase 5: API del operador. Mínimo 24 caracteres; genera uno con: openssl rand -hex 24
# CAZA_API_TOKEN=
# CAZA_API_PORT=3080

# Fase 7: alertas al operador. Webhook JSON genérico (Apprise /notify, ntfy, Slack/Discord incoming webhook, Make) y/o Telegram.
# CAZA_NOTIFY_WEBHOOK_URL=https://...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Fase 3: conectores reales. Cada conector se activa solo si está 'validado' y habilitado en caza_connectors
# (PUT /api/v1/caza/connectors/:clave) Y tiene credenciales. Identificadores por producto: PUT /api/v1/caza/products/:slug/identifiers
# BESTBUY_API_KEY=
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_ENV=production            # o sandbox mientras eBay aprueba producción
# MELI_ACCESS_TOKEN=             # o bien MELI_CLIENT_ID + MELI_CLIENT_SECRET + MELI_REFRESH_TOKEN
# MELI_CLIENT_ID=
# MELI_CLIENT_SECRET=
# MELI_REFRESH_TOKEN=
# PAAPI_ACCESS_KEY=              # Amazon Associates con ventas calificadas; sirve para amazon_mx y amazon_us
# PAAPI_SECRET_KEY=
# PAAPI_PARTNER_TAG=
# Ingesta externa (changedetection.io, Make): POST /api/v1/caza/observations con X-CAZA-Token

# Fase 4: tipo de cambio USD→MXN. Sin BANXICO_TOKEN se usa Frankfurter; sin red, USD_MXN_RATE (marcado como 'fijo').
# BANXICO_TOKEN=
# FRANKFURTER_URL=https://api.frankfurter.dev/v1   # o tu instancia autoalojada
